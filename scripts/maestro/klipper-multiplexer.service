# Systemd service for Maestro Grand 2 IDEX Host Serial Multiplexer
# Installed on Orange Pi Zero (or host SBC)

[Unit]
Description=Maestro Grand 2 IDEX Klipper Serial Multiplexer Daemon
Documentation=https://github.com/Klipper3d/klipper
Before=klipper.service
After=network.target local-fs.target
# Never give up restarting: /dev/ttyS1 may appear late, and klipper must
# not start without the PTYs.  (Default StartLimit would trip after 5 tries.)
StartLimitIntervalSec=0

[Service]
Type=simple
User=klipper
# Direct-bus topology:
#   /dev/ttyS1 - point-to-point link to the ATmega1284p USART0.  Klipper
#                opens it directly (stock MCU); the mux does not touch it.
#   /dev/ttyS0 - local transceiver on the toolhead/bed bus.
# The kernel console and serial getty must be disabled on ttyS0 first
# (console=display in /boot/armbianEnv.txt, serial-getty@ttyS0 masked).
Environment=PERIPH_PORT=/dev/ttyS0
Environment=SERIAL_BAUD=250000
# Silence required after the last packet before the bus is released.
# The old MCU router timed this in firmware; 3ms is too tight for the
# Python host arbiter when head0 is streaming HX711 data.
Environment=BUS_GUARD=0.012
Environment=BUS_TIMEOUT=0.050
Environment=TAP_LOG=/home/klipper/printer_data/logs/maestro_bus.log
# Use Klipper's virtualenv: it provides pyserial (the system python3 does not).
ExecStart=/home/klipper/klippy-env/bin/python /home/klipper/klipper/scripts/maestro/host_multiplexer.py --periph-port ${PERIPH_PORT} --baud ${SERIAL_BAUD} --bus-guard ${BUS_GUARD} --bus-timeout ${BUS_TIMEOUT} --tap-log ${TAP_LOG}
Restart=always
RestartSec=2
KillMode=process

[Install]
WantedBy=multi-user.target
