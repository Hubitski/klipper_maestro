# Klipper Firmware Configuration for Toolhead 1 Right Carriage (ATmega16A)
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_AVR=y
CONFIG_MACH_atmega16=y
CONFIG_MCU="atmega16"
CONFIG_AVR_FREQ_16000000=y
CONFIG_CLOCK_FREQ=16000000
CONFIG_AVR_CLKPR=-1
CONFIG_AVR_STACK_SIZE=192
CONFIG_AVR_WATCHDOG=y
CONFIG_SERIAL=y
CONFIG_SERIAL_BAUD_U2X=y
CONFIG_SERIAL_PORT=0
CONFIG_SERIAL_BAUD=250000
CONFIG_SERIAL_NODE_ID=0x30
CONFIG_SERIAL_POLLED_SLAVE=y
CONFIG_HAVE_LIMITED_CODE_SIZE=y
CONFIG_HAVE_GPIO=y
CONFIG_HAVE_GPIO_ADC=y
CONFIG_HAVE_STRICT_TIMING=y
CONFIG_WANT_ADC=y
# Toolheads have a single ADC consumer; the ADC timer clamp is only
# needed where several channels share the converter (saves flash).
CONFIG_ADC_TIMER_CLAMP=y
# Fan state before Klipper connects: hotend fan (PD4) on, part fan (PD5)
# forced off, so the hotend is cooled from power-up instead of the part
# cooling fan spinning on a floating pin.
CONFIG_INITIAL_PINS="PD4,!PD5"
# Code size optimizations for ATmega16 (16KB Flash / 1KB RAM)
CONFIG_WANT_DEBUGCMDS=n
CONFIG_WANT_STATS=n
CONFIG_INLINE_STEPPER_HACK=n
CONFIG_WANT_ENDSTOP=n
CONFIG_WANT_HARD_PWM=n
# Hardware SPI is needed to configure the toolhead's TMC2130 extruder
# driver.  Software SPI is more expensive in flash and is not used.
CONFIG_WANT_SPI=y
CONFIG_WANT_SOFTWARE_SPI=n
# All default-on SPI sensors must be disabled or they add ~10KB of flash.
CONFIG_WANT_ADXL345=n
CONFIG_WANT_LIS2DW=n
CONFIG_WANT_BMI160=n
CONFIG_WANT_THERMOCOUPLE=n
CONFIG_WANT_ADS131M0X=n
CONFIG_WANT_ADS1220=n
CONFIG_WANT_SENSOR_ANGLE=n
CONFIG_WANT_I2C=n
CONFIG_WANT_BUTTONS=n
CONFIG_WANT_NEOPIXEL=n
CONFIG_WANT_ST7920=n
CONFIG_WANT_HD44780=n
CONFIG_WANT_HX71X=y
CONFIG_WANT_CS1237=n
CONFIG_WANT_TMCUART=n
CONFIG_WANT_PULSE_COUNTER=n
CONFIG_WANT_TRIGGER_ANALOG=y
