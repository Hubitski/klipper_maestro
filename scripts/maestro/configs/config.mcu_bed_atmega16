# Klipper Firmware Configuration for Heated Bed (ATmega16A)
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_AVR=y
CONFIG_MACH_atmega16=y
CONFIG_MCU="atmega16"
CONFIG_AVR_FREQ_16000000=y
CONFIG_CLOCK_FREQ=16000000
CONFIG_AVR_CLKPR=-1
CONFIG_AVR_STACK_SIZE=256
CONFIG_AVR_WATCHDOG=y
CONFIG_SERIAL=y
CONFIG_SERIAL_BAUD_U2X=y
CONFIG_SERIAL_PORT=0
CONFIG_SERIAL_BAUD=250000
CONFIG_SERIAL_NODE_ID=0x40
CONFIG_SERIAL_POLLED_SLAVE=y
CONFIG_HAVE_LIMITED_CODE_SIZE=y
CONFIG_HAVE_GPIO=y
CONFIG_HAVE_GPIO_ADC=y
CONFIG_HAVE_STRICT_TIMING=y
CONFIG_WANT_ADC=y
# Code size optimizations: disable unused peripherals on ATmega16 (16KB Flash / 1KB RAM)
CONFIG_WANT_HARD_PWM=n
CONFIG_WANT_SPI=n
CONFIG_WANT_I2C=n
CONFIG_WANT_BUTTONS=n
CONFIG_WANT_NEOPIXEL=n
CONFIG_WANT_ST7920=n
CONFIG_WANT_HD44780=n
CONFIG_WANT_HX71X=n
CONFIG_WANT_CS1237=n
CONFIG_WANT_TMCUART=n
CONFIG_WANT_PULSE_COUNTER=n
CONFIG_WANT_TRIGGER_ANALOG=n
