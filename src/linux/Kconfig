# Kconfig settings for compiling and running the micro-controller code
# in a Linux process

if MACH_LINUX

config LINUX_SELECT
    bool
    default y
    # command.h needs a concrete MESSAGE_DEST; without SERIAL the Kconfig
    # emits an empty CONFIG_SERIAL_NODE_ID (literally "0x") and the build
    # fails.  The Linux MCU talks over a unix socket, but it still uses the
    # same framing and the default node id 0x10 is the correct one.
    select SERIAL
    select HAVE_GPIO
    select HAVE_GPIO_ADC
    select HAVE_GPIO_SPI
    select HAVE_GPIO_I2C
    select HAVE_GPIO_HARD_PWM

config BOARD_DIRECTORY
    string
    default "linux"

config CLOCK_FREQ
    int
    default 50000000

endif
